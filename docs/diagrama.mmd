flowchart TB
  subgraph F["API de fuentes · Bearer · 600 rpm · ETag"]
    direction LR
    C["chats Slack<br/>users · channels"]
    D["26 docs<br/>PDF · HTML · MD"]
    T["clientes.csv · transacciones.csv<br/>pqrs.xml · empleados.xml"]
  end
  subgraph A["POST /run · pipeline determinista (Python stdlib)"]
    direction LR
    I["1 Ingesta exhaustiva<br/>PDF Info UTF-16, Keywords<br/>comentarios HTML/XML<br/>front matter, adjuntos, URLs"]
    R["2 Grafo de identificadores<br/>CL · KP · uid · radicado<br/>cédula · correo · celular<br/>placa · pasaporte · crédito<br/>nombre = etiqueta, no llave"]
    DET["3 Detección en capas<br/>diccionario normalizado<br/>patrones + deletreados<br/>dirección, honorífico<br/>coincidencia tolerante<br/>LLM de recall con caché"]
    RES["4 Resolución con evidencia<br/>llave > id fuerte > fecha+monto<br/>> adjunto > hilo<br/>gazetteer del corpus<br/>contra falsos positivos"]
    I --> R --> DET --> RES
  end
  subgraph B["Seudonimizar y verificar"]
    direction LR
    P["5 Seudónimo determinista<br/>HMAC + catálogo colombiano<br/>mismo género y patrón<br/>apodo, handle, slug"]
    REP["6 Reemplazo con formato<br/>puntos, mayúsculas,<br/>deletreado, URL, reporta_a<br/>nunca reescribe"]
    Q["7 Cuasi-identificadores<br/>maestro: siempre<br/>texto: los de la persona<br/>+ tuplas sin nombre"]
    CHK["8 Verificación adversarial<br/>barrido global de formas<br/>ataque de enlace<br/>validar.mjs"]
    P --> REP --> Q --> CHK
  end
  F --> I
  RES --> P
  M[("grafo + pseudomap<br/>+ caché LLM · volumen")]
  P <--> M
  CHK --> O["output/<br/>chats · docs · tables<br/>+ entities.json honesto"]
  M --> AN["POST /anonymize<br/>mismo grafo y mapa<br/>50 registros en menos de 60 s"]
  O --> S["Servicio /v1 en Railway<br/>/health · /run · /output · /entities"]
  AN --> S
  CHK -.-> J["Juez local<br/>replica validar.mjs<br/>sample + tests + trampas del corpus"]

  classDef store fill:#1c1a33,stroke:#6fcf97,color:#f2f1fb
